{
  "name": "workbench-v1",
  "private": true,
  "version": "0.1.0",
  "description": "Local authoring environment where designers edit real React source visually, and agent edits and visual edits land in the same files.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "dev:designops": "vite --config projects/DESIGNOPS2/vite.config.ts",
    "build": "npm run workbench:licenses && tsc -b && vite build --config vite.config.ts",
    "build:designops": "vite build --config projects/DESIGNOPS2/vite.config.ts",
    "workbench:bridge": "npm run workbench:compile-host && node scripts/workbench-bridge-launcher.mjs",
    "workbench:core-dev": "node scripts/workbench-core-dev-server.mjs",
    "workbench:check-core": "node scripts/check-workbench-core-dev-server.mjs",
    "workbench:check-authoring": "npm run workbench:compile-host && node scripts/check-workbench-preview-css.mjs && node scripts/check-workbench-authoring-gateway.mjs",
    "workbench:authoring-mcp": "node scripts/workbench-authoring-mcp.mjs",
    "workbench:check-hosted-core-api": "node scripts/check-workbench-hosted-core-api.mjs",
    "workbench:check-artifact-fidelity": "node scripts/check-workbench-artifact-fidelity.mjs",
    "workbench:check-starter": "npm run workbench:check-artifact-fidelity && node scripts/check-workbench-starter-components.mjs",
    "workbench:manual-shadcn-contracts": "node scripts/manual-inspect-shadcn-contracts.mjs",
    "workbench:tailwind-sync": "node scripts/workbench-tailwind-sync.mjs",
    "workbench:install-figma-assets": "node scripts/install-figma-assets.mjs",
    "deploy:vercel": "node scripts/deploy-workbench-vercel.mjs",
    "preview": "vite preview",
    "preview:designops": "vite preview --config projects/DESIGNOPS2/vite.config.ts",
    "check": "tsc -p tsconfig.app.json --noEmit",
    "workbench:check-tokens": "node scripts/check-token-regressions.mjs",
    "workbench:check-story-props": "node scripts/audit-story-prop-order.mjs scripts/workbench-starter/shadcn-base/src/components/ui scripts/workbench-starter/astryx/src/components && node scripts/audit-story-controls.mjs scripts/workbench-starter/shadcn-base/src/components/ui && node scripts/audit-story-controls.mjs scripts/workbench-starter/astryx/src/components",
    "workbench:sync-project-guidance": "node scripts/sync-workbench-project-guidance.mjs",
    "workbench:check-project-guidance-sync": "node scripts/check-workbench-project-guidance-sync.mjs",
    "workbench:check-guidance": "node scripts/check-workbench-agent-guidance.mjs && npm run workbench:check-project-guidance-sync",
    "workbench:check-harness": "npm run workbench:check-guidance && npm run workbench:check-authoring",
    "workbench:check-design": "node scripts/check-design-editor-foundation.mjs && npm run test:editable-tree && npm run test:project-session && npm run workbench:check-guidance",
    "workbench:check-config": "node scripts/check-workbench-config.mjs",
    "workbench:check-portability": "node scripts/check-workbench-portability.mjs",
    "workbench:check-host-parity": "node scripts/check-workbench-host-parity.mjs",
    "workbench:licenses": "node scripts/generate-third-party-node-notices.mjs && node scripts/generate-third-party-runtime-notices.mjs",
    "figma:publish": "node scripts/figma-publisher/publish-library.mjs",
    "figma:primitives": "node scripts/figma-publisher/primitive-automation.mjs",
    "figma:primitives:audit": "node scripts/figma-publisher/primitive-automation.mjs audit --project \"Figma Comp Test\"",
    "figma:primitives:plan": "node scripts/figma-publisher/primitive-automation.mjs plan --project \"Figma Comp Test\"",
    "figma:primitives:write-specs": "node scripts/figma-publisher/primitive-automation.mjs write-specs --project \"Figma Comp Test\" --write",
    "workbench:init": "node scripts/init-workbench.mjs",
    "stabilize": "node scripts/stabilization-iterations.mjs",
    "test:editable-tree": "tsc -p tsconfig.editable-tree-tests.json --noEmit && node scripts/run-editable-tree-tests.mjs",
    "test:project-session": "tsc -p tsconfig.project-session-tests.json --noEmit && node scripts/run-project-session-tests.mjs",
    "test:gestures": "node scripts/gesture-tests/run.mjs",
    "workbench:compile-host": "tsc -p tsconfig.host.json",
    "workbench:check-bridge": "npm run workbench:compile-host && node scripts/check-host-bridge.mjs"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@remixicon/react": "^4.9.0",
    "@shadcn/react": "^0.2.0",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.26",
    "@tiptap/react": "^3.23.4",
    "@tiptap/starter-kit": "^3.23.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "esbuild": "^0.28.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.11.0",
    "next-themes": "^0.4.6",
    "postcss": "8.5.10",
    "radix-ui": "^1.6.1",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-is": "^19.2.7",
    "react-resizable-panels": "^4.11.2",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/generator": "^7.29.7",
    "@babel/parser": "^7.29.7",
    "@babel/types": "^7.29.7",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "puppeteer-core": "^25.4.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.3"
  }
}
